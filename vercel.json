{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(favicon.*|apple-touch-icon.png|site.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/face-lift",
      "destination": "/the-facelift.html",
      "permanent": true
    },
    {
      "source": "/face-lift/",
      "destination": "/the-facelift.html",
      "permanent": true
    },
    {
      "source": "/facelift",
      "destination": "/the-facelift.html",
      "permanent": true
    },
    {
      "source": "/rhinoplasty",
      "destination": "/rhinoplasty-delhi.html",
      "permanent": true
    },
    {
      "source": "/rhinoplasty/",
      "destination": "/rhinoplasty-delhi.html",
      "permanent": true
    },
    {
      "source": "/neck-lift",
      "destination": "/neck-lift-delhi.html",
      "permanent": true
    },
    {
      "source": "/neck-lift/",
      "destination": "/neck-lift-delhi.html",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact.html",
      "permanent": true
    },
    {
      "source": "/contact-us/",
      "destination": "/contact.html",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/about.html",
      "permanent": true
    },
    {
      "source": "/about-us/",
      "destination": "/about.html",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/journal.html",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/journal.html",
      "permanent": true
    }
  ]
}